@startuml cjm-user
title CJM: пользователь оформляет заказ в Авито.Кухня

start

:Открывает список заведений\n(GET /api/v1/restaurants);
:Выбирает заведение;
:Смотрит меню\n(GET /api/v1/restaurants/{id}/menu);

if (Нужный товар доступен?) then (нет)
  :Видит отметку "нет в наличии",\nвыбирает другой товар;
endif

:Формирует корзину из позиций меню;
:Отправляет заказ\n(POST /api/v1/orders);

if (Заказ прошёл валидацию?) then (нет)
  :Получает ошибку 422\n(пустой заказ / товар чужого заведения /\nтовар стал недоступен) и правит корзину;
  stop
else (да)
  :Заказ создан со статусом "created";
endif

:Периодически проверяет статус\n(GET /api/v1/orders/{id});

if (Передумал, пока заказ не начали готовить?) then (да)
  :Отменяет заказ\n(POST /api/v1/orders/{id}/cancel);
  :Статус "cancelled";
  stop
endif

repeat
  :Видит очередной статус:\naccepted -> cooking -> ready;
repeat while (статус ещё не финальный?) is (да)
->нет;

if (Финальный статус) then (delivered)
  :Заказ выполнен;
else (rejected / cancelled)
  :Заказ не выполнен,\nвидит причину;
endif

stop
@enduml
